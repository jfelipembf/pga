# -------------------------------------------------------------
# ARQUIVO DE REFERÊNCIA (.env.example) - NÃO COLOQUE SENHAS AQUI
# -------------------------------------------------------------
# Copie este arquivo para .env.development e preencha localmente
# Em produção (Vercel/Hosting), cadastre essas chaves no Dashboard
# -------------------------------------------------------------

# --- FIREBASE CLIENT (Seguro para expor no HTML do React) ---
REACT_APP_APIKEY="CHAVE_PUBLICA_DO_FIREBASE_AQUI"
REACT_APP_AUTHDOMAIN="SEU_PROJETO.firebaseapp.com"
REACT_APP_PROJECTID="SEU_PROJETO"
REACT_APP_STORAGEBUCKET="SEU_PROJETO.appspot.com"
REACT_APP_MESSAGINGSENDERID="000000000000"
REACT_APP_APPID="1:000000000000:web:abcdef123456"
REACT_APP_MEASUREMENTID="G-XXXXXXXXXX"

# --- CONFIGURAÇÕES DA APLICAÇÃO ---
# URL canônica usada para geração de links e QR Codes
REACT_APP_APP_URL="http://localhost:3000"

# =============================================================
# 🚨 CHAVES SENSÍVEIS - DEVEM ESTAR APENAS NAS CLOUD FUNCTIONS!
# =============================================================
# As chaves abaixo NUNCA devem ser lidas no React (process.env.NO_FRONT)
# 
# OPENAI_API_KEY=sk-... 
# EVOLUTION_API_KEY=...
# STRIPE_SECRET_KEY=sk_...
# 
# O Frontend não deve saber dessas chaves. Apenas as chame via:
# const func = httpsCallable(functions, 'myAIAnalyzer');
# =============================================================
